# Kopiera till .env och fyll i dina uppgifter. .env laddas aldrig upp till git.
# Lämna tomt för att använda kontot som redan är inloggat i MT5-terminalen.
MT5_LOGIN=12345678
MT5_PASSWORD=ditt_lösenord
MT5_SERVER=DinBroker-Demo
# Valfritt: sökväg till terminal64.exe om du har flera MT5-installationer
MT5_PATH=
